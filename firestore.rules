rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      // Users can READ their own document only
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Users CANNOT write directly - all writes go through backend (Admin SDK)
      // This prevents users from modifying:
      //   - plan (free → pro upgrade)
      //   - usageCount (reset usage)
      //   - maxUsage (increase limits)
      //   - createdAt
      allow write: if false;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
