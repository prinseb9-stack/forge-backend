# FORGE Environment Configuration Example
# Copy this file to .env1, .env2, or .env3 based on your plan

# FREE Plan (.env1) - OpenRouter Free Router
OPENROUTER_API_KEY=your_openrouter_key_here

# PRO Plan (.env2) - DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_key_here

# HIGHER PRO Plan (.env3) - Meta Llama 4 via OpenRouter
OPENROUTER_API_KEY=your_openrouter_key_here

# Server Configuration
PORT=8080
DEV_MODE=true

# Temporary development plan selection
# Options: free, pro, higher_pro
FORGE_PLAN=free

# Token encryption (base64-encoded 32-byte key, generate with: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=your_base64_key_here

# Cloudflare R2 (Media Studio Stage 1 - placeholders only, never real secrets)
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here

# Cloudflare R2 (Media Studio Stage 1 - placeholders only, never real secrets)
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here

# Cloudflare R2 (Media Studio Stage 1 — placeholders only, never real secrets)
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_r2_bucket_name_here
