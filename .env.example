# FORGE Environment Configuration Example
# Copy this file to .env1, .env2, or .env3 based on your plan

# FREE Plan (.env1) - OpenRouter Free Router
OPENROUTER_API_KEY=your_openrouter_key_here

# PRO Plan (.env2) - DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_key_here

# HIGHER PRO Plan (.env3) - Meta Llama 4 via OpenRouter
OPENROUTER_API_KEY=your_openrouter_key_here

# Server Configuration
PORT=8080
DEV_MODE=true

# Temporary development plan selection
# Options: free, pro, higher_pro
FORGE_PLAN=free
